# Configuration de déploiement OVH Web Cloud Multisite
# Copie ce fichier en .env.deploy puis remplis les valeurs.
# Récupère-les dans OVH → Web Cloud → ton hébergement → onglet FTP-SSH.

# Hôte SFTP (le numéro du cluster varie — le tien : cluster129)
OVH_HOST="ftp.cluster129.hosting.ovh.net"

# Login SFTP (colonne "Login" dans OVH → FTP-SSH ; souvent le nom du compte)
OVH_USER="tonsite-ovh"

# Mot de passe SFTP (celui de l'utilisateur FTP-SSH, pas le mot de passe manager)
OVH_PASSWORD=""

# Port SFTP (22 par défaut chez OVH)
OVH_PORT="22"

# Dossiers racine de chaque sous-domaine (relatifs au home SFTP).
# À vérifier dans OVH → Multisite : colonne "Dossier racine" de chaque domaine.
OVH_DIR_WWW="www"       # avisdoc.fr / www
OVH_DIR_ADMIN="admin"   # admin.avisdoc.fr
OVH_DIR_CLIENT="client" # client.avisdoc.fr
