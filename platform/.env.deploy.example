# Déploiement des frontends sur OVH Web Cloud.
# Copier en platform/.env.deploy puis remplir. Récupérer dans
# OVH → Web Cloud → hébergement → onglet FTP-SSH.

# Hôte + login SFTP/SSH (le numéro de cluster varie)
OVH_HOST="ftp.cluster021.hosting.ovh.net"
OVH_USER="tonsite-ovh"
OVH_PORT="22"

# Mot de passe SFTP — uniquement pour les offres sans clé SSH (Web Cloud Éco).
# Laisser vide si tu utilises une clé SSH (mode rsync).
OVH_PASSWORD=""

# Répertoires racine de chaque sous-domaine (OVH → Multisite → un dossier par
# sous-domaine). Ex. admin.avisdoc.fr -> /admin, client.avisdoc.fr -> /client.
OVH_ADMIN_DIR="/admin"
OVH_CLIENT_DIR="/client"
